:root {
  --ink: #17211d;
  --muted: #718078;
  --line: #e5ebe7;
  --green: #1b925e;
  --nav: #14231d;
}

.invoice-admin{min-width:1540px}
.saving-measures{max-width:180px;color:#7b8982;font-size:8px;line-height:1.45}
.saving-measures.active{padding:7px 9px;border-radius:7px;background:#edf8f2;color:#166e4a}
.saving-measures b{font-size:8px}
.row-saving{display:block;color:#118458;font-size:12px;white-space:nowrap}
.row-saving small{display:block;margin-top:3px;color:#6e8077;font-size:7px;font-weight:600}

