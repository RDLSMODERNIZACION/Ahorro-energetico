@media (max-width: 1050px) {
  .kpis {
    grid-template-columns: repeat(2, 1fr);
  }
  .analysis-grid,
  .projection,
  .map-layout {
    grid-template-columns: 1fr;
  }
  .drop em {
    display: none;
  }
  .result {
    grid-row: 2;
  }
  .meter-list {
    max-height: 400px;
  }
}
@media (max-width: 720px) {
  .shell {
    display: block;
  }
  .side {
    position: relative;
    height: auto;
    padding: 14px;
  }
  .brand {
    padding-bottom: 14px;
  }
  .side nav {
    display: flex;
    overflow: auto;
  }
  .side nav button {
    white-space: nowrap;
  }
  .privacy {
    display: none;
  }
  .work {
    padding: 20px 14px;
  }
  header {
    align-items: flex-start;
    gap: 15px;
  }
  .head-actions {
    align-items: flex-end;
    flex-direction: column;
  }
  .head-actions > span {
    display: none;
  }
  .kpis {
    grid-template-columns: 1fr 1fr;
  }
  .analysis-grid {
    display: block;
  }
  .findings {
    margin-top: 14px;
  }
  .action {
    grid-template-columns: 36px 1fr 45px;
  }
  .action > input {
    grid-column: 2/4;
    width: 100%;
  }
  .map {
    height: 520px;
  }
}
@media print {
  .side,
  .head-actions,
  .drop,
  .scenario,
  .chartbox {
    display: none;
  }
  .shell {
    display: block;
  }
  .work {
    padding: 0;
  }
  .projection {
    display: block;
  }
  .result {
    min-height: 600px;
  }
  .result button {
    display: none;
  }
}

