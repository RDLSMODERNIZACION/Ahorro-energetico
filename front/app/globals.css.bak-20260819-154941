@media(max-width:1100px){.dashboard-savings-grid{grid-template-columns:repeat(2,1fr)}.dashboard-status{grid-template-columns:1fr}.status-summary{grid-template-columns:repeat(2,1fr)}}

.month-control{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:16px}.month-control>div{background:white;border:1px solid var(--line);border-radius:11px;padding:17px 20px}.month-control span{display:block;color:#718078;font-size:9px;font-weight:750;text-transform:uppercase;letter-spacing:.05em}.month-control strong{display:block;margin-top:8px;font-size:24px;color:#26382f}.month-control .received strong,.month-control .complete strong{color:#16875a}.month-control .missing{background:#fff4f1;border-color:#efc7bd}.month-control .missing strong{color:#c94c39}.missing-invoice-panel{margin-bottom:16px;border-color:#edc8bf}.missing-meter-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;padding:14px;max-height:255px;overflow:auto;background:#fffaf8}.missing-meter-grid article{display:flex;gap:10px;align-items:center;padding:12px;border:1px solid #efd8d1;border-radius:9px;background:white}.missing-meter-grid i{display:grid;place-items:center;flex:0 0 25px;height:25px;border-radius:50%;background:#fff0ed;color:#cb513f;font-style:normal;font-weight:900}.missing-meter-grid b,.missing-meter-grid span,.missing-meter-grid small{display:block}.missing-meter-grid b{font-size:10px}.missing-meter-grid span{margin-top:3px;font-size:9px;color:#4e5f56}.missing-meter-grid small{margin-top:4px;font-size:8px;color:#8b9791}.missing-table{border-top:8px solid #f1f3f2;overflow:auto}.missing-table-title{display:flex;justify-content:space-between;padding:13px 18px;background:#e8ebea;color:#5f6d66;font-size:9px}.missing-invoice-row{background:#eef0ef!important;color:#7f8984}.missing-invoice-row td{border-bottom-color:#dfe3e1!important}.missing-invoice-row b{color:#6d7772}.missing-placeholder{text-align:center;color:#87918c;font-size:9px;font-style:italic}.missing-badge{display:inline-block;padding:6px 9px;border-radius:6px;background:#d9dddb;color:#65716b;font-size:8px;font-weight:850}@media(max-width:1100px){.month-control{grid-template-columns:repeat(2,1fr)}.missing-meter-grid{grid-template-columns:repeat(2,1fr)}}

