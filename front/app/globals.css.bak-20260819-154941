table {
  border-collapse: collapse;
  width: 100%;
  font-size: 10px;
}
th {
  text-align: left;
  color: #829087;
  background: #fbfcfb;
  padding: 10px 13px;
  font-size: 8px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.sort-head{display:inline-flex;align-items:center;gap:6px;border:0;background:transparent;color:inherit;padding:0;font:inherit;text-transform:inherit;letter-spacing:inherit;cursor:pointer;font-weight:800}.sort-head:hover{color:#168657}.sort-head i{font-style:normal;font-size:7px;color:#2a8c62}
.power-sort span{text-align:left}.power-sort span small{display:block;margin-top:3px;color:#8a9790;font-size:6px;letter-spacing:0;text-transform:none;font-weight:600}.power-sort i{min-width:28px;text-align:right}
td {
  padding: 13px;
  border-top: 1px solid #edf0ee;
  vertical-align: middle;
}
td b,
td strong {
  font-size: 10px;
}
td small {
  display: block;
  color: #89958f;
  margin-top: 3px;
}
.supply {
  display: flex;
  align-items: center;
  gap: 9px;
  min-width: 130px;
}
.supply > i {
  width: 24px;
  height: 24px;
  background: #edf5f1;
  color: #27825b;
  border-radius: 7px;
  display: grid;
  place-items: center;
  font-weight: 800;
  font-style: normal;
}
.bar {
  height: 4px;
  background: #e8eeeb;
  border-radius: 3px;
  margin-top: 5px;
  width: 75px;
}
.bar i {
  display: block;
  height: 100%;
  background: #e1a34d;
  border-radius: 3px;
}
.tag {
  display: inline-block;
  padding: 3px 8px;
  border-radius: 20px;
  font-size: 8px;
  font-weight: 800;
}
.tag.high {
  background: #fff0ed;
  color: #d45b46;
}
.tag.mid {
  background: #fff6df;
  color: #b67d27;
}
.tag.low {
  background: #eaf7f0;
  color: #238459;
}
.save {
  color: #168758;
}
.finding {
  display: flex;
  gap: 11px;
  padding: 15px 17px;
  border-bottom: 1px solid #edf0ee;
}
.finding > i {
  width: 30px;
  height: 30px;
  flex: 0 0 auto;
  background: #eef7f2;
  color: #239462;
  border-radius: 8px;
  display: grid;
  place-items: center;
  font-style: normal;
}
.finding b {
  font-size: 10px;
}
.finding p {
  font-size: 9px;
  color: #78867f;
  line-height: 1.5;
  margin: 4px 0;
}
.finding button {
  border: 0;
  background: transparent;
  padding: 0;
  color: #148658;
  font-size: 9px;
  font-weight: 750;
  cursor: pointer;
}
.projection {
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.75fr);
  gap: 16px;
}
.action {
  display: grid;
  grid-template-columns: 38px 1fr 150px 38px;
  gap: 13px;
  align-items: center;
  padding: 17px 20px;
  border-bottom: 1px solid #edf0ee;
}
.action b {
  font-size: 11px;
}
.action small {
  display: block;
  font-size: 9px;
  color: #89958f;
  margin-top: 4px;
}
.action > strong {
  font-size: 12px;
  color: #168657;
}
.action > input {
  accent-color: var(--green);
}
.action label input {
  display: none;
}
.action label i {
  display: block;
  width: 31px;
  height: 18px;
  border-radius: 20px;
  background: #ccd6d1;
  position: relative;
}
.action label i:after {
  content: "";
  position: absolute;
  width: 14px;
  height: 14px;
  left: 2px;
  top: 2px;
  background: #fff;
  border-radius: 50%;
  transition: 0.2s;
}
.action label input:checked + i {
  background: var(--green);
}
.action label input:checked + i:after {
  left: 15px;
}
.result {
  background: linear-gradient(150deg, #123327, #1a5b3f);
  border-radius: 12px;
  color: white;
  padding: 24px;
}
.result > p {
  font-size: 9px;
  letter-spacing: 0.12em;
  color: #9bc7b4;
}
.result > strong {
  font-size: 31px;
  display: block;
  margin-top: 12px;
}
.result > span {
  font-size: 10px;
  color: #a9c8ba;
}
.gauge {
  height: 6px;
  background: #ffffff22;
  border-radius: 4px;
  margin: 20px 0;
}
.gauge i {
  display: block;
  height: 100%;
  background: #49df98;
  border-radius: 4px;
}
.result-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-top: 1px solid #ffffff20;
  border-bottom: 1px solid #ffffff20;
  padding: 16px 0;
  gap: 10px;
}
.result-grid span {
  font-size: 8px;
  color: #9fc2b2;
}
.result-grid b {
  display: block;
  color: white;
  font-size: 11px;
  margin-top: 5px;
}
.payback {
  display: flex;
  justify-content: space-between;
  padding: 17px 0;
  font-size: 10px;
}
.result button {
  width: 100%;
  border: 0;
  background: #fff;
  color: #17543b;
  border-radius: 8px;
  padding: 11px;
  font-weight: 750;
  font-size: 10px;
  cursor: pointer;
}
.chartbox {
  grid-column: 1/-1;
  padding-bottom: 14px;
}
.chart {
  height: 220px;
  margin: 20px 35px 0;
  border-bottom: 1px solid #ccd7d1;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  background: repeating-linear-gradient(
    to bottom,
    #fff 0,
    #fff 54px,
    #eef2f0 55px
  );
}
.chart > div {
  width: 15%;
  text-align: center;
}
.chart section {
  height: 185px;
  display: flex;
  gap: 6px;
  align-items: flex-end;
  justify-content: center;
}
.chart section i,
.chart section b {
  width: 22px;
  background: #bbc8c1;
  border-radius: 4px 4px 0 0;
}
.chart section b {
  background: #2ba36b;
}
.chart span {
  font-size: 9px;
  color: #75847c;
}
.legend {
  display: flex;
  gap: 20px;
  justify-content: center;
  margin-top: 14px;
  font-size: 9px;
  color: #78877f;
}
.legend span:last-child {
  color: #2ba36b;
}
.map-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 300px;
  gap: 15px;
}
.map-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 17px 19px;
  border-bottom: 1px solid var(--line);
}
.map-head > span {
  font-size: 9px;
  color: #148557;
  background: #eaf7f0;
  padding: 7px 9px;
  border-radius: 20px;
}
.map {
  height: 640px;
  position: relative;
  overflow: hidden;
  background-color: #e9eee9;
  background-image:
    linear-gradient(
      28deg,
      transparent 47%,
      #d4ddd6 48%,
      #f8faf8 51%,
      transparent 52%
    ),
    linear-gradient(
      -22deg,
      transparent 44%,
      #dce4de 45%,
      #fff 48%,
      transparent 49%
    ),
    repeating-linear-gradient(90deg, transparent 0 69px, #dee6e0 70px),
    repeating-linear-gradient(0deg, transparent 0 59px, #dfe6e1 60px);
}
.river {
  position: absolute;
  left: 40%;
  top: -10%;
  height: 120%;
  width: 80px;
  background: #c4ded9;
  transform: rotate(13deg);
  border-left: 10px solid #d8e6df;
  border-right: 10px solid #d8e6df;
}
.route {
  position: absolute;
  font-size: 7px;
  color: #86948c;
  letter-spacing: 0.18em;
}
.r1 {
  top: 15%;
  left: 11%;
  transform: rotate(-18deg);
}
.r2 {
  bottom: 16%;
  left: 55%;
  transform: rotate(17deg);
}
.zone {
  position: absolute;
  font-size: 32px;
  color: #77908614;
  letter-spacing: 0.08em;
}
.west {
  left: 8%;
  top: 46%;
}
.center {
  left: 40%;
  top: 25%;
}
.east {
  right: 8%;
  top: 49%;
}
.marker {
  position: absolute;
  transform: translate(-50%, -50%);
  cursor: grab;
  touch-action: none;
  z-index: 4;
}
.marker > i {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border-radius: 50% 50% 50% 5px;
  transform: rotate(-45deg);
  background: #fff;
  color: #168958;
  border: 2px solid #22a56b;
  box-shadow: 0 3px 9px #173c2c35;
  font-style: normal;
}
.marker label {
  position: absolute;
  left: 37px;
  top: -5px;
  background: #fff;
  padding: 6px 9px;
  border-radius: 6px;
  box-shadow: 0 2px 8px #1e392b22;
  white-space: nowrap;
  font-size: 9px;
  font-weight: 750;
  opacity: 0;
  pointer-events: none;
  transform: translateX(-5px);
  transition: .15s ease;
}
.marker:hover,.marker.selected{z-index:12}.marker:hover label,.marker.selected label{opacity:1;transform:none}
.marker label small {
  display: block;
  color: #85928b;
  font-size: 7px;
  margin-top: 2px;
}
.marker.selected > i {
  background: #168958;
  color: #fff;
  transform: rotate(-45deg) scale(1.18);
}
.map-search{display:flex;align-items:center;gap:13px;padding:10px 18px;border-bottom:1px solid var(--line);background:#f8faf9}.map-search input{width:min(430px,60%);height:35px;border:1px solid #d7e3dc;border-radius:8px;background:white;padding:0 11px;font:inherit;font-size:10px}.map-search small{color:#7d8b84;font-size:8px}.map-panel .map{height:690px}.map-panel .marker>i{width:25px;height:25px;font-size:10px}.map-panel .marker label{left:31px;top:-6px;max-width:290px;overflow:hidden;text-overflow:ellipsis}

