* {
  box-sizing: border-box;
}
body {
  margin: 0;
  background: #f4f7f5;
  color: var(--ink);
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    "Segoe UI",
    sans-serif;
}
.shell {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 238px 1fr;
}
.side {
  background: var(--nav);
  color: white;
  padding: 27px 18px;
  display: flex;
  flex-direction: column;
  position: sticky;
  top: 0;
  height: 100vh;
}
.brand {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 0 10px 30px;
}
.brand > span {
  width: 38px;
  height: 38px;
  border: 1px solid #4f7162;
  color: #51d998;
  border-radius: 10px;
  display: grid;
  place-items: center;
  font: 800 23px Georgia;
}
.brand b {
  font-size: 18px;
  letter-spacing: 0.14em;
}
.brand small {
  display: block;
  color: #89a096;
  font-size: 8px;
  letter-spacing: 0.17em;
  margin-top: 3px;
}
.side nav {
  display: grid;
  gap: 5px;
}
.side nav button {
  border: 0;
  background: transparent;
  color: #9eb1a8;
  text-align: left;
  padding: 13px 14px;
  border-radius: 9px;
  font-weight: 650;
  cursor: pointer;
}
.side nav button > span {
  margin-left: 15px;
}
.side nav button.active {
  background: #254136;
  color: white;
}
.privacy {
  margin-top: auto;
  border-top: 1px solid #294037;
  padding: 20px 8px 0;
  color: #9fddc1;
  font-size: 11px;
}
.privacy small {
  display: block;
  color: #71877d;
  margin: 7px 0 0 15px;
}
.work {
  padding: 28px 34px 45px;
  min-width: 0;
}
header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25px;
}
header p {
  font-size: 10px;
  color: #809087;
  letter-spacing: 0.14em;
  font-weight: 700;
  margin: 0 0 7px;
}
h1 {
  font-size: 27px;
  margin: 0;
  letter-spacing: -0.025em;
}
.head-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}
.head-actions > span {
  font-size: 11px;
  color: #5c6e64;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 10px 12px;
  max-width: 250px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.head-actions button {
  border: 0;
  background: var(--green);
  color: #fff;
  padding: 11px 16px;
  border-radius: 8px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 5px 12px #15865322;
}
.drop {
  background: #fff;
  border: 1.5px dashed #9bcbb4;
  border-radius: 12px;
  display: flex;
  align-items: center;
  padding: 17px 22px;
  gap: 15px;
  cursor: pointer;
  transition: 0.2s;
}
.drop.drag {
  background: #eaf8f0;
  border-color: var(--green);
}
.drop > i {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  background: #e7f6ee;
  color: var(--green);
  display: grid;
  place-items: center;
  font-size: 23px;
  font-style: normal;
}
.drop b {
  font-size: 13px;
}
.drop span {
  display: block;
  font-size: 11px;
  color: var(--muted);
  margin-top: 3px;
}
.drop em {
  margin-left: auto;
  color: #839088;
  font-size: 9px;
  font-style: normal;
}
.kpis {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 13px;
  margin: 16px 0;
}
.kpis article {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 11px;
  padding: 17px 18px;
}
.kpis article > span {
  color: #75847c;
  font-size: 10px;
  font-weight: 650;
}
.kpis strong {
  display: block;
  font-size: 21px;
  margin: 8px 0 5px;
  letter-spacing: -0.04em;
}
.kpis strong i {
  font-size: 11px;
  font-style: normal;
  color: #66776e;
}
.kpis small {
  font-size: 9px;
  color: #8b9891;
}
.kpis .green {
  background: #1d8f5d;
  color: white;
  border: 0;
}
.kpis .green span,
.kpis .green small {
  color: #c8eedb;
}
.analysis-grid {
  display: grid;
  grid-template-columns: minmax(0, 2.1fr) minmax(260px, 0.7fr);
  gap: 15px;
}
.panel {
  background: white;
  border: 1px solid var(--line);
  border-radius: 12px;
  overflow: hidden;
}
.panel-title {
  padding: 17px 19px;
  border-bottom: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.panel-title h2,
.map-head h2 {
  font-size: 14px;
  margin: 0;
}
.panel-title p,
.map-head p {
  font-size: 10px;
  color: var(--muted);
  margin: 4px 0 0;
}
.panel-title button {
  border: 0;
  background: #edf7f2;
  color: #178557;
  border-radius: 7px;
  padding: 8px 10px;
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
}
.table {
  overflow: auto;
}
